{
  "_comment": "GitLab.com official MCP through mcp-remote OAuth plus co-located Google Workspace MCP. OAuth state is persisted outside the model-visible company directory. openexecutive/orchestrator/mcp_gateway.py limits GitLab writes to GITLAB_WRITE_NAMESPACES, blocks unknown future GitLab tools, and applies roster-based egress gates to Gmail, Calendar, and Drive sharing.",
  "mcpServers": {
    "gitlab": {
      "command": "/usr/local/bin/mcp-remote",
      "args": [
        "https://gitlab.com/api/v4/mcp",
        "--static-oauth-client-metadata",
        "{\"scope\":\"mcp\"}",
        "--transport",
        "http-only"
      ],
      "env": {
        "HOME": "/data",
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "MCP_REMOTE_CONFIG_DIR": "/data/mcp-auth/gitlab"
      }
    },
    "google_workspace": {
      "command": "/usr/local/bin/workspace-mcp-launch.sh",
      "args": [],
      "env": {
        "GWORKSPACE_AUTH_MODE": "$GWORKSPACE_AUTH_MODE",
        "WORKSPACE_MCP_TOOL_TIER": "$WORKSPACE_MCP_TOOL_TIER",
        "WORKSPACE_MCP_TOOLS": "$WORKSPACE_MCP_TOOLS",
        "WORKSPACE_MCP_CREDENTIALS_DIR": "$WORKSPACE_MCP_CREDENTIALS_DIR",
        "GOOGLE_OAUTH_CLIENT_ID": "$GOOGLE_OAUTH_CLIENT_ID",
        "GOOGLE_OAUTH_CLIENT_SECRET": "$GOOGLE_OAUTH_CLIENT_SECRET",
        "GOOGLE_SERVICE_ACCOUNT_KEY_JSON": "$GOOGLE_SERVICE_ACCOUNT_KEY_JSON",
        "GOOGLE_SERVICE_ACCOUNT_KEY_FILE": "$GOOGLE_SERVICE_ACCOUNT_KEY_FILE",
        "USER_GOOGLE_EMAIL": "$USER_GOOGLE_EMAIL"
      }
    }
  },
  "filters": {
    "access_control": {
      "deny_patterns": [
        "*__delete_*",
        "*__drop_*",
        "*__destroy_*",
        "*__remove_*",
        "*delete_email*",
        "*delete_message*",
        "*trash*",
        "*delete_file*",
        "*delete_document*"
      ],
      "deny": [],
      "allow_servers": ["gitlab", "google_workspace"]
    },
    "load_control": {
      "deny_url_patterns": ["*"],
      "allow_url_patterns": []
    },
    "similarity_threshold": 0.3
  }
}
